{
  "accountId": "YOUR_AWS_ACCOUNT_ID",
  "region": "YOUR_AWS_REGION",
  "frontend": {
    "origin": "https://YOUR_CLOUDFRONT_DOMAIN",
    "websiteBucket": "YOUR_WEBSITE_BUCKET"
  },
  "api": {
    "id": "YOUR_API_ID",
    "baseUrl": "https://YOUR_API_ID.execute-api.YOUR_AWS_REGION.amazonaws.com",
    "stage": "$default",
    "functionName": "YOUR_LAMBDA_FUNCTION_NAME",
    "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/YOUR_LAMBDA_EXECUTION_ROLE"
  },
  "cognito": {
    "userPoolId": "YOUR_AWS_REGION_YOUR_POOL_ID",
    "clientId": "YOUR_PUBLIC_CLIENT_ID",
    "issuer": "https://cognito-idp.YOUR_AWS_REGION.amazonaws.com/YOUR_AWS_REGION_YOUR_POOL_ID",
    "domain": "https://YOUR_COGNITO_DOMAIN.auth.YOUR_AWS_REGION.amazoncognito.com",
    "redirectUri": "https://YOUR_CLOUDFRONT_DOMAIN/",
    "logoutUri": "https://YOUR_CLOUDFRONT_DOMAIN/",
    "scopes": [
      "openid",
      "email"
    ]
  },
  "storage": {
    "customersTable": "YOUR_CUSTOMERS_TABLE",
    "ordersTable": "YOUR_ORDERS_TABLE",
    "activityTable": "YOUR_ACTIVITY_TABLE",
    "partitionKey": "PK",
    "sortKey": "SK",
    "documentsBucket": "YOUR_DOCUMENTS_BUCKET"
  },
  "featureDefaults": {
    "voiceEnabled": false,
    "kycMode": "mock"
  }
}
