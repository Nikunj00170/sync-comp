{
  "AllowOrigins": [
    "https://YOUR_CLOUDFRONT_DOMAIN"
  ],
  "AllowMethods": [
    "GET",
    "POST",
    "PUT",
    "PATCH",
    "DELETE",
    "OPTIONS"
  ],
  "AllowHeaders": [
    "authorization",
    "content-type",
    "idempotency-key"
  ],
  "AllowCredentials": false,
  "MaxAge": 300,
  "ExposeHeaders": [
    "X-Next-Cursor"
  ]
}
