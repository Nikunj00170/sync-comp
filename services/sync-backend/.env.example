# Copy to services/sync-backend/.env.local. Spring loads this optional file automatically
# when launched from the repo root or this backend directory (including the IDE Run button).
# OS/IDE variables and command-line arguments override these local values.
# Syntax: KEY=value or KEY="quoted value". No shell expansion or multiline values.
# Do not commit .env.local. The repo-root env file is for frontend/Node AI configuration.

SERVER_PORT=8080
# Start with memory; choose dynamodb once your tables and AWS login are ready.
SYNC_STORAGE=memory
SYNC_DOCUMENTS=memory
AWS_REGION=ap-south-1
# Optional name of an authenticated local AWS profile. Credentials stay in AWS's shared store.
# AWS_PROFILE=your-profile
CUSTOMERS_TABLE=YOUR_CUSTOMERS_TABLE
ORDERS_TABLE=YOUR_ORDERS_TABLE
ACTIVITY_TABLE=YOUR_ACTIVITY_TABLE

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Optional override; normally derived from pool ID and region.
COGNITO_ISSUER_URI=
SYNC_DEMO_ENABLED=false
KYC_MODE=mock
SYNC_KYC_OCR=fixtures
SYNC_PUBLIC_BASE_URL=http://localhost:8080
SYNC_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# Later, after configuring S3, select aws for mandatory DynamoDB + S3 adapters.
# SPRING_PROFILES_ACTIVE=aws
# DOCUMENTS_BUCKET=YOUR_DOCUMENTS_BUCKET
# FRONTEND_ORIGIN=https://YOUR_CLOUDFRONT_DOMAIN
# APP_ENV=prototype
# Optional SYNC_KYC_OCR=textract requires Textract permission for supported image OCR.
# Lambda uses real runtime variables and execution-role credentials; it skips automatic local files.
# Disable local loading with SYNC_BACKEND_ENV_ENABLED=false.
# Optional SYNC_BACKEND_ENV_FILE=/absolute/path/to/backend.env for another working directory.
