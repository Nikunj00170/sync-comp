# Export values in your shell/runtime; Spring does not auto-load dotenv files.
# Local development defaults (public routes work; protected routes need Cognito).
COGNITO_ISSUER_URI=
COGNITO_CLIENT_ID=
SYNC_STORAGE=memory
SYNC_DOCUMENTS=memory
SYNC_DEMO_ENABLED=false
KYC_MODE=mock
SYNC_PUBLIC_BASE_URL=http://localhost:8080
SYNC_CORS_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# AWS deployment: use this block instead of the memory/origin settings above.
# SPRING_PROFILES_ACTIVE=aws
# AWS_REGION=ap-south-1
# CUSTOMERS_TABLE=YOUR_CUSTOMERS_TABLE
# ORDERS_TABLE=YOUR_ORDERS_TABLE
# ACTIVITY_TABLE=YOUR_ACTIVITY_TABLE
# DOCUMENTS_BUCKET=YOUR_DOCUMENTS_BUCKET
# COGNITO_USER_POOL_ID=ap-south-1_YOUR_POOL_ID
# COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
# FRONTEND_ORIGIN=https://YOUR_CLOUDFRONT_DOMAIN
# APP_ENV=prototype
# VOICE_ENABLED=false
# Lambda provides AWS_REGION and execution-role credentials automatically.
# No static AWS access keys belong here. No provider secret is needed for mock KYC.
# Optional compatibility overrides: SYNC_DYNAMODB_TABLE (single-table storage),
# SYNC_DOCUMENTS_BUCKET, COGNITO_ISSUER_URI and SYNC_CORS_ALLOWED_ORIGINS.
