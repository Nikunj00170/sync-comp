# Intended app configuration contract; no app loads this file yet.
# Copy to an ignored .env only when the workspace/env loader is implemented.
# VITE_* values are public browser configuration. Put no secrets in them.
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.YOUR_AWS_REGION.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.YOUR_AWS_REGION.amazonaws.com/YOUR_AWS_REGION_YOUR_POOL_ID
VITE_COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
VITE_COGNITO_DOMAIN=https://YOUR_COGNITO_DOMAIN.auth.YOUR_AWS_REGION.amazoncognito.com
VITE_REDIRECT_URI=https://YOUR_CLOUDFRONT_DOMAIN/
VITE_LOGOUT_URI=https://YOUR_CLOUDFRONT_DOMAIN/
VITE_OIDC_SCOPE="openid email"
VITE_VOICE_ENABLED=false

# Backend configuration currently entered in Lambda.
APP_ENV=prototype
CUSTOMERS_TABLE=YOUR_CUSTOMERS_TABLE
ORDERS_TABLE=YOUR_ORDERS_TABLE
ACTIVITY_TABLE=YOUR_ACTIVITY_TABLE
DOCUMENTS_BUCKET=YOUR_DOCUMENTS_BUCKET
COGNITO_USER_POOL_ID=YOUR_AWS_REGION_YOUR_POOL_ID
COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
FRONTEND_ORIGIN=https://YOUR_CLOUDFRONT_DOMAIN
VOICE_ENABLED=false
KYC_MODE=mock

# Proposed future adapter settings. Leave blank until integration is implemented.
# Store live values server-side in the chosen AWS secret/configuration service.
OPENAI_API_KEY=
SARVAM_API_KEY=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# Lambda supplies its Region and execution-role credentials automatically.
