# Copy to ignored .env.local at the repository root to configure the customer web build.
# The local demo works without any credentials.
# VITE_* values are public browser configuration. Put no secrets in them.
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.YOUR_AWS_REGION.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.YOUR_AWS_REGION.amazonaws.com/YOUR_AWS_REGION_YOUR_POOL_ID
VITE_COGNITO_CLIENT_ID=YOUR_PUBLIC_CLIENT_ID
VITE_COGNITO_DOMAIN=https://YOUR_COGNITO_DOMAIN.auth.YOUR_AWS_REGION.amazoncognito.com
VITE_REDIRECT_URI=https://YOUR_CLOUDFRONT_DOMAIN/
VITE_LOGOUT_URI=https://YOUR_CLOUDFRONT_DOMAIN/
VITE_OIDC_SCOPE="openid email"
VITE_VOICE_ENABLED=false
# Text advisor uses the same server gateway, without microphone or Sarvam.
VITE_CHAT_ENABLED=false
# Optional separate voice gateway origin; blank uses the local /api/voice proxy.
VITE_VOICE_API_BASE_URL=

# Spring settings belong in services/sync-backend/.env.local.
# Copy services/sync-backend/.env.example for backend configuration.
# Variables below are server-only credentials for the separate Node AI service.
# Sales bot reasoning (server only).
GEMINI_API_KEY=
# Optional second key; same-project keys still share quota.
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.5-flash

# Local voice backend: npm run dev:voice (app in another terminal: npm run dev)
# Local catalogue sales bot: npm run sales:bot -- "your question"
# Server-only secret; never use a VITE_ prefix.
SARVAM_API_KEY=
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
